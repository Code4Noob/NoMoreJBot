# BOT
BOT_TOKEN=
BOT_NAME=

# MONGO DB
MONGOURL=
DB_NAME=
# 如果用本地 MongoDB（MONGOURL 留空時用下面分開設定）
MONGOUSER=
MONGOPASSWORD=
MONGOHOST=
MONGOPORT=

# AI 選擇 - gemini（預設） / deepseek / gpt
AI_PROVIDER=gemini

# 用邊個 base skill（對應 src/ai/skills/<AI_SKILL>.md），預設 base
# per-user skill 放 src/ai/skills/users/{userId}.md
AI_SKILL=base

# 聊天歷史 - 每次送俾 AI 嘅 context 行數 + 檔案最大行數（超過刪舊）
CHAT_CONTEXT_SIZE=30
MAX_HISTORY_LINES=200

# Gemini（AI_PROVIDER=gemini 時用）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# DeepSeek V4（AI_PROVIDER=deepseek 時用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GPT（AI_PROVIDER=gpt 時用，Azure OpenAI）
AZURE_OPENAI_URL=
AZURE_OPENAI_KEY=

# VPN (Surfshark OpenVPN tunnel) - 自動偵測 tun interface IP，tunnel 未起就用普通 axios，唔使設定