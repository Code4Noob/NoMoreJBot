# BOT
BOT_TOKEN=
BOT_NAME=

# MONGO DB
MONGOURL=
DB_NAME=
# 如果用本地 MongoDB（MONGOURL 留空時用下面分開設定）
MONGOUSER=
MONGOPASSWORD=
MONGOHOST=
MONGOPORT=

# AI 選擇 - gemini（預設） / deepseek / gpt / glm / openrouter
AI_PROVIDER=gemini

# 用邊個 base skill（對應 src/ai/skills/<AI_SKILL>.md），預設 base
# per-user skill 放 src/ai/skills/users/{userId}.md
AI_SKILL=base

# 聊天歷史 - 每次送俾 AI 嘅 context 行數 + 檔案最大行數（超過刪舊）
CHAT_CONTEXT_SIZE=30
MAX_HISTORY_LINES=200

# Gemini（AI_PROVIDER=gemini 時用）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# DeepSeek V4（AI_PROVIDER=deepseek 時用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Vision model（有圖就自動轉用呢個嚟睇圖）
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# GPT（AI_PROVIDER=gpt 時用，Azure OpenAI）
AZURE_OPENAI_URL=
AZURE_OPENAI_KEY=

# GLM（AI_PROVIDER=glm 時用，智譜 Zhipu BigModel，OpenAI-compatible）
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Vision model（有圖就自動轉用呢個嚟睇圖；glm-5.3-flash 實測接受 image input）
GLM_VISION_MODEL=glm-5.3-flash
# 推理強度（reasoning_effort）：low = 最低（最快）/ medium / high
AI_REASONING_EFFORT=low
# GLM 生圖（CogView）——AI_PROVIDER=glm 時 `gen image` / /draw 用呢個，唔使 Gemini key
GLM_IMAGE_MODEL=cogview-4-250304
GLM_IMAGE_SIZE=1024x1024

# OpenRouter（AI_PROVIDER=openrouter 時用，一個 key 用齊所有 vendor 嘅 model）
# Model 名格式 vendor/model，清單: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# （可選）OpenRouter app 排名用
OPENROUTER_SITE_URL=
# Cost 估算用：OpenRouter 每 model 價差好遠，記得填返所選 model 嘅實價（USD per 1M tokens）
OPENROUTER_PRICE_PROMPT=3
OPENROUTER_PRICE_CACHED=0.3
OPENROUTER_PRICE_COMPLETION=15

# ── AI 每日用量限制（所有 provider 通用）──
# 爆 limit 嘅話 bot 唔會再 call AI，直接回覆用戶 limit reached，第二日自動 reset

# VPN (Surfshark OpenVPN tunnel) - 自動偵測 tun interface IP，tunnel 未起就用普通 axios，唔使設定
# 可選：sudo password（VPN 自動重啟用，非互動）。唔設就每次喺 terminal 問你密碼。
# 注意：.env 係 gitignored，但呢個係敏感資料，自己衡量風險。
# Docker 入面冇 TTY，所以一定要設呢個值（container 行 root，sudo 唔會真係要密碼）。
SUDO_PASSWORD=
MAX_TOKENS_PER_QUESTION = 1000000

# ───────────────────────────── SLACK（可選）─────────────────────────────
# 想 bot 同時行 Telegram + Slack 就填呢兩條；唔填就淨係行 Telegram。
# @slack/bolt + Socket Mode（唔使 public URL）。
# Bot token（xoxb-...）同 App-level token（xapp-...）都喺 Slack App 嘅
# "OAuth & Permissions" / "Basic Information > App-Level Tokens" 攞。
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# （可選）邊啲 Slack user 係 admin（逗號分隔，例如 U0123ABCDE,U0456FGHIJ）——/quit 先准用
SLACK_ADMIN_IDS=
# （可選）回覆方式：true = 開 thread 回覆；false / 唔填 = 直接出 message 去 channel（預設）
SLACK_REPLY_IN_THREAD=false
# （可選）Slash command 回覆顯示：me（預設）= Only visible to you（淨係撳嗰個人見到）；channel = 出晒成個 channel
SLACK_COMMAND_VISIBLE=me

# 0 = unlimited
AI_DAILY_TOKEN_LIMIT=2000000
AI_DAILY_COST_LIMIT=0.5          # USD per day
AI_USAGE_FILE=log/ai-usage.json  # optional, default shown
# 睇今日用量: /quota（Telegram & Slack 都有）