# BOT
BOT_TOKEN=
BOT_NAME=

# AI 選擇 - 用邊個 model 做對話
# gemini（預設） / deepseek
AI_PROVIDER=gemini

# DeepSeek V4（AI_PROVIDER=deepseek 時用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
